# AI Provider configuration
# Options: 'gemini', 'fallback'
AI_PROVIDER=gemini
# Comma-separated list of Gemini API keys for rotation
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
AI_FALLBACK_PROVIDER=fallback
REPLICATE_API_TOKEN=

# Database & Storage
DATABASE_URL=sqlite:///./stylemirror.db
STORAGE_DIR=./storage
PHOTO_TTL_HOURS=24

# Security & Limits
RATE_LIMIT_ANON_PER_HOUR=10
DAILY_GENERATION_CAP=500
ALLOWED_ORIGIN=http://localhost:8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production
SENTRY_DSN=
